# Copy to .env (ignored). Either point at a private credentials file...
CF_ENV_FILE=/path/to/private/cf.env
# ...or set the credentials directly (token needs Pages edit, Zone DNS edit, Zone rulesets edit).
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# Optional overrides (defaults shown):
# CF_PAGES_PROJECT=metribay
# CF_PAGES_DOMAIN=metribay.com
# CF_PAGES_REDIRECT_HOSTS=www.metribay.com
