---
import Page from '../layouts/Page.astro';
import Arrow from './Arrow.astro';
import Dashboard from './Dashboard.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import { copy, type Locale } from '../i18n/copy';
import { company } from '../lib/company';
import { contact, legal, local, register, selfHosted } from '../lib/urls';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = copy[locale];
const i = t.integrations;
const integrations = [
  { name: 'Google Analytics', mark: 'GA', ...i.ga },
  { name: 'Umami', mark: 'U', ...i.umami },
  { name: 'Search Console', mark: 'SC', ...i.gsc },
  { name: 'Bing Webmaster', mark: 'B', ...i.bing },
  { name: 'GitHub', mark: 'GH', ...i.github },
  { name: 'WordPress.org', mark: 'W', ...i.wporg },
  { name: 'UptimeRobot', mark: 'UR', ...i.uptime },
];
const cloud = t.pricing.cloud;
const self = t.pricing.self;
---
<Page locale={locale}>
  <SiteHeader locale={locale} />
  <main id="main" tabindex="-1">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-inner wrap">
        <p class="eyebrow"><span class="little-dot"></span>{t.eyebrow}</p>
        <h1 id="hero-title">{t.headline[0]}<br /><span>{t.headline[1]}</span></h1>
        <p class="hero-intro">{t.intro}</p>
        <div class="hero-actions"><a class="button button-primary" href={register}>{t.cta}<Arrow /></a><a class="text-link" href="#pricing">{t.secondary}<span aria-hidden="true">↓</span></a></div>
        <p class="cta-note">{t.heroNote}</p>
        {locale === 'de' && <p class="cta-note app-language">{t.appLanguage}</p>}
      </div>
      <div class="preview-stage" id="preview"><div class="preview-inner wrap"><Dashboard locale={locale} /></div></div>
    </section>

    <section class="how-section wrap" id="how" aria-labelledby="how-title">
      <div class="section-intro"><p class="eyebrow">{t.how.label}</p><h2 id="how-title">{t.how.heading}</h2></div>
      <ol class="steps-list">{t.how.steps.map((step, index) => <li><span class="step-number" aria-hidden="true">{index + 1}</span><h3>{step.title}</h3><p>{step.text}</p></li>)}</ol>
    </section>

    <section class="integrations-section" id="integrations" aria-labelledby="integrations-title"><div class="wrap">
      <div class="section-intro"><p class="eyebrow">{t.sourcesLabel}</p><h2 id="integrations-title">{t.sourcesHeading}</h2><p>{t.sourcesIntro}</p></div>
      <ul class="integrations-list">{integrations.map(item => <li><span class="integration-mark" aria-hidden="true">{item.mark}</span><div><strong>{item.name}</strong><span>{item.category}</span><small>{item.metrics}</small></div></li>)}</ul>
    </div></section>

    <section class="benefits-section" id="why" aria-labelledby="benefits-title"><div class="wrap">
      <div class="benefits-heading"><p class="eyebrow">{t.benefitsLabel}</p><h2 id="benefits-title">{t.benefitsHeading}</h2></div>
      <div class="benefits-list">{t.benefits.map(item => <article><span class="feature-number">{item.number}</span><h3>{item.title}</h3><p>{item.text}</p></article>)}</div>
    </div></section>

    <section class="security-section wrap" id="security" aria-labelledby="security-title">
      <div class="security-heading"><p class="eyebrow">{t.security.label}</p><h2 id="security-title">{t.security.heading}</h2><p>{t.security.intro}</p></div>
      <ul class="security-list">{t.security.items.map(item => <li><h3><span class="little-dot"></span>{item.title}</h3><p>{item.text}</p></li>)}</ul>
    </section>

    <section class="pricing-section" id="pricing" aria-labelledby="pricing-title"><div class="wrap">
      <div class="section-intro"><p class="eyebrow">{t.pricing.label}</p><h2 id="pricing-title">{t.pricing.heading}</h2><p>{t.pricing.intro}</p></div>
      <div class="plans">
        <article class="plan plan-featured" aria-labelledby="plan-cloud">
          <p class="plan-badge">{cloud.badge}</p>
          <h3 id="plan-cloud">{cloud.name}</h3>
          <p class="plan-price"><strong>{cloud.price}</strong> <span>{cloud.unit}</span></p>
          <p class="plan-alt">{cloud.alt}</p>
          <p class="plan-vat">{cloud.vat}</p>
          <p class="plan-text">{cloud.text}</p>
          <ul class="plan-features">{cloud.features.map(feature => <li>{feature}</li>)}</ul>
          <a class="button button-primary" href={register}>{cloud.cta}<Arrow /></a>
          <p class="plan-note">{cloud.note}</p>
        </article>
        <article class="plan" aria-labelledby="plan-self">
          <p class="plan-badge">{self.badge}</p>
          <h3 id="plan-self">{self.name}</h3>
          <p class="plan-price"><strong>{self.price}</strong></p>
          <p class="plan-alt">{self.alt}</p>
          <p class="plan-text">{self.text}</p>
          <ul class="plan-features">{self.features.map(feature => <li>{feature}</li>)}</ul>
          <a class="button button-secondary" href={selfHosted}>{self.cta}<Arrow /></a>
        </article>
      </div>
      <div class="plan-details">
        <div><h3>{t.pricing.unitsHeading}</h3><p>{t.pricing.units}</p></div>
        <p>{t.pricing.larger} <a class="inline-link" href={contact}>{company.email}</a></p>
      </div>
    </div></section>

    <section class="about-section wrap" id="about" aria-labelledby="about-title">
      <div class="about-visual" aria-hidden="true"><img src={local('assets/metribay-mark.svg')} width="200" height="200" alt="" /><span class="about-initials">RI</span></div>
      <div class="about-copy"><p class="eyebrow">{t.about.label}</p><h2 id="about-title">{t.about.heading}</h2>{t.about.paragraphs.map(text => <p>{text}</p>)}<a class="text-link" href={contact}>{t.about.email} · {company.email}<span aria-hidden="true">→</span></a></div>
    </section>

    <section class="faq-section" id="faq" aria-labelledby="faq-title"><div class="wrap faq-inner">
      <div class="faq-heading"><p class="eyebrow">{t.faq.label}</p><h2 id="faq-title">{t.faq.heading}</h2></div>
      <div class="faq-list">{t.faq.items.map(item => <details><summary>{item.q}</summary><p>{item.a}{'link' in item && item.link && <> <a class="inline-link" href={legal(locale, item.link)}>{t.footerLinks[item.link]} →</a></>}</p></details>)}</div>
    </div></section>

    <section class="final-section" aria-labelledby="final-title"><div class="wrap final-inner"><div><p class="eyebrow">Metribay<span class="brand-dot">.</span></p><h2 id="final-title">{t.finalHeading}</h2><p>{t.finalText}</p></div><div class="final-action"><a class="button button-primary" href={register}>{t.cta}<Arrow /></a><p class="cta-note">{t.finalNote}</p>{locale === 'de' && <p class="cta-note app-language">{t.appLanguage}</p>}</div></div></section>
  </main>
  <SiteFooter locale={locale} />
</Page>
